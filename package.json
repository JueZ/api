{
  "name": "api-catalogue-v0",
  "version": "0.1.0",
  "private": true,
  "description": "v0 Hello World skeleton for the personal API catalogue platform.",
  "type": "module",
  "scripts": {
    "lint": "eslint apps scripts --max-warnings 0 && prettier --check .",
    "type-check": "tsc -p apps/api/tsconfig.json --noEmit && ng build --configuration development --no-progress",
    "test": "npm run build:api && node scripts/run-tests.mjs apps/api/test apps/web/test scripts/test",
    "test:api": "npm run build:api && node scripts/run-tests.mjs apps/api/test",
    "test:youtube:live": "npm run build:api --silent && node scripts/run-tests.mjs --youtube-live apps/api/test/youtube-live.test.mjs",
    "test:gates": "node --test scripts/test/path-classifier.test.mjs scripts/test/gate-aggregate.test.mjs scripts/test/native-automerge-policy.test.mjs",
    "test:delivery": "node --test scripts/test/deployment-impact.test.mjs scripts/test/deployment-generation.test.mjs scripts/test/delivery-v2-workflow.test.mjs scripts/test/known-good-release.test.mjs",
    "test:repair": "node --test scripts/test/agent-learning-triage.test.mjs scripts/test/agent-learning-artifacts.test.mjs",
    "build": "npm run build:web && npm run build:api",
    "build:web": "ng build --configuration production --no-progress",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:functions": "npm run build:api",
    "build:release": "npm run build && bash scripts/build-release-artifacts.sh",
    "test:ops": "node scripts/run-tests.mjs scripts/test",
    "ops:smoke": "node scripts/smoke-runtime.mjs",
    "ops:smoke:auth": "node scripts/smoke-auth.mjs",
    "ops:runtime-truth": "node scripts/runtime-truth.mjs",
    "ops:validate-release-ledger": "node scripts/validate-release-ledger.mjs",
    "ops:check-telemetry": "node scripts/check-telemetry.mjs",
    "ops:triage-repair-issues": "node scripts/triage-repair-issues.mjs",
    "ops:policy-guardrails": "node scripts/policy-guardrails.mjs",
    "ops:validate-autonomous-policy": "node -e \"import('./scripts/lib/autonomous-policy.mjs').then(({ loadAutonomousPolicy }) => { loadAutonomousPolicy(); console.log('Autonomous policy is valid.'); })\"",
    "ops:write-release-ledger": "node scripts/write-release-ledger.mjs",
    "ops:mint-smoke-token": "node scripts/mint-smoke-token.mjs",
    "ops:resolve-reddit-share": "npm run build:api --silent && node scripts/resolve-reddit-share-url.mjs",
    "ops:check-openapi-drift": "node scripts/check-openapi-route-drift.mjs",
    "ops:check-operation-drift": "npm run build:api --silent && node scripts/check-operation-contract-drift.mjs",
    "ops:check-architecture": "node scripts/check-architecture.mjs",
    "ops:validate-agent-skills": "node scripts/validate-agent-skills.mjs",
    "ops:check-lockfile": "node scripts/check-lockfile-policy.mjs",
    "eval:agents": "npm run build:api --silent && node scripts/run-agent-evals.mjs",
    "agent:learning:validate": "node scripts/agent-learning/validate-artifacts.mjs && node scripts/agent-learning/generate-index.mjs --check",
    "agent:learning:index": "node scripts/agent-learning/generate-index.mjs",
    "docs:check-operations": "npm run build:api --silent && node scripts/generate-operation-docs.mjs --check",
    "eval:codex:validate": "node scripts/codex-evals/validate.mjs",
    "eval:codex:test": "node scripts/run-tests.mjs scripts/codex-evals/test",
    "eval:codex": "node scripts/codex-evals/run.mjs",
    "eval:codex:report": "node scripts/codex-evals/report.mjs",
    "agent:env": "node scripts/agent-env/cli.mjs start",
    "agent:env:start": "node scripts/agent-env/cli.mjs start",
    "agent:env:status": "node scripts/agent-env/cli.mjs status",
    "agent:env:logs": "node scripts/agent-env/cli.mjs logs",
    "agent:env:reset": "node scripts/agent-env/cli.mjs reset",
    "agent:env:stop": "node scripts/agent-env/cli.mjs stop",
    "agent:verify": "node scripts/agent-env/cli.mjs verify",
    "agent:env:test": "node scripts/run-tests.mjs scripts/agent-env/test"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@azure/functions": "4.14.0",
    "@azure/identity": "^4.13.1",
    "@azure/msal-browser": "^5.10.1",
    "@azure/storage-blob": "^12.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^6.2.3",
    "openai": "^6.38.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.40.0",
    "@types/node": "24.10.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.6",
    "hono": "4.12.34",
    "nanoid": "3.3.18",
    "@angular/build": {
      "undici": "7.29.0"
    },
    "@hono/node-server": "2.0.11"
  }
}
