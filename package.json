{
  "name": "api-catalogue-v0",
  "version": "0.1.0",
  "private": true,
  "description": "v0 Hello World skeleton for the personal API catalogue platform.",
  "type": "module",
  "scripts": {
    "lint": "npm run type-check",
    "type-check": "tsc -p apps/api/tsconfig.json --noEmit && ng build --configuration development --no-progress",
    "test": "sh -c 'npm run build:api && node --test apps/api/test/*.test.mjs apps/web/test/*.test.mjs scripts/test/*.test.mjs'",
    "test:api": "sh -c 'npm run build:api && node --test apps/api/test/*.test.mjs'",
    "build": "npm run build:web && npm run build:api",
    "build:web": "ng build --configuration production --no-progress",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:functions": "npm run build:api",
    "test:ops": "node --test scripts/test/*.test.mjs",
    "ops:smoke": "node scripts/smoke-runtime.mjs",
    "ops:smoke:auth": "node scripts/smoke-auth.mjs",
    "ops:runtime-truth": "node scripts/runtime-truth.mjs",
    "ops:validate-release-ledger": "node scripts/validate-release-ledger.mjs",
    "ops:check-telemetry": "node scripts/check-telemetry.mjs",
    "ops:triage-repair-issues": "node scripts/triage-repair-issues.mjs",
    "ops:policy-guardrails": "node scripts/policy-guardrails.mjs",
    "ops:write-release-ledger": "node scripts/write-release-ledger.mjs",
    "ops:mint-smoke-token": "node scripts/mint-smoke-token.mjs",
    "ops:resolve-reddit-share": "npm run build:api --silent && node scripts/resolve-reddit-share-url.mjs"
  },
  "dependencies": {
    "@angular/common": "21.2.12",
    "@angular/compiler": "21.2.12",
    "@angular/core": "21.2.12",
    "@angular/platform-browser": "21.2.12",
    "@azure/functions": "4.14.0",
    "@azure/msal-browser": "^5.10.1",
    "jose": "^6.2.3",
    "openai": "^6.38.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "yaml": "^2.9.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.10",
    "@angular/cli": "21.2.10",
    "@angular/compiler-cli": "21.2.12",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
