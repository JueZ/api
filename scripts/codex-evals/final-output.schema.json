{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "tests", "uncertainties", "phaseStatus", "evidence"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "tests": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "phaseStatus": {
      "type": "string",
      "enum": ["not_applicable", "not_started", "in_progress", "accepted", "blocked"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "prChecks", "merge", "deployment", "runtime"],
      "properties": {
        "local": { "$ref": "#/$defs/evidenceState" },
        "prChecks": { "$ref": "#/$defs/evidenceState" },
        "merge": { "$ref": "#/$defs/evidenceState" },
        "deployment": { "$ref": "#/$defs/evidenceState" },
        "runtime": { "$ref": "#/$defs/evidenceState" }
      }
    }
  },
  "$defs": {
    "evidenceState": {
      "type": "string",
      "enum": ["verified", "failed", "blocked", "not_evaluated", "not_applicable"]
    }
  }
}
